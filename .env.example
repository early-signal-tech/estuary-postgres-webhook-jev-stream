# Shared by jev-app and jev-classifier. Copy to .env (in this folder) and fill in.

# Both apps' ngrok tunnels. https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# jev-classifier only. https://console.typesafe.ai/
TYPESAFE_API_KEY=
# jev-classifier only. Any long random string; use the same value in the Estuary
# materialization's x-webhook-secret header.
WEBHOOK_SECRET=
